# GEAMS settings. Copy to /etc/geams/geams.env, fill in, then:  chmod 600 /etc/geams/geams.env
# Lines starting with # are off. Nothing here is a real secret: you must make your own.

PORT=8080
# Only the web proxy (Caddy/nginx) should reach GEAMS. Keep this on 127.0.0.1.
GEAMS_BIND=127.0.0.1

# ---- Where the data lives (all on a disk that survives restarts) ----
GEAMS_DATA=/var/lib/geams/geams-data.json
GEAMS_HQ_USERS=/var/lib/geams/geams-hq-users.json
GEAMS_BLOBS=/var/lib/geams/blobs
GEAMS_BACKUP_DIR=/var/lib/geams/backups

# ---- First HQ owner (created on first start only; change the password after login) ----
GEAMS_HQ_ADMIN_USER=hqadmin
GEAMS_HQ_ADMIN_PASSWORD=CHANGE-ME-to-a-long-passphrase

# ---- Safety net: database copy of everything (strongly recommended) ----
# GEAMS_DATABASE_URL=postgres://user:password@host:5432/geams
# GEAMS_DATABASE_SSL=1

# ---- Backups (daily by default). Set a passphrase: without it keys are left out of backups ----
GEAMS_BACKUP_HOURS=24
GEAMS_BACKUP_KEEP=14
GEAMS_BACKUP_PASSPHRASE=CHANGE-ME-and-store-this-somewhere-else-too
# GEAMS_BACKUP_PUT_URL=https://your-offsite-storage/geams/
# GEAMS_BACKUP_PUT_AUTH=Bearer xxxxx

# ---- Pilot ----
GEAMS_PILOT_LABEL=Pilot
GEAMS_ESCALATE_SECS=120
GEAMS_ESCALATE_OFFLINE_SECS=45
# Seconds before a forwarded fire or ambulance alert that no crew has taken is flagged to that agency's own HQ (0 = off)
GEAMS_AGENCY_ESCALATE_SECS=120

# ---- Rules ----
GEAMS_REQUIRE_COMMANDER_ACCOUNTS=1
# GEAMS_REQUIRE_VERIFIED_CIVILIANS=1
# GEAMS_SEED_DEFAULT_STATIONS=1     # ONLY for a demo. Real pilots: create stations in HQ.

# ---- Text messages (needed for phone restore and codes). See GEAMS-DEPLOY-CHECKLIST.txt ----
# GEAMS_SMS_URL=
# GEAMS_SMS_API_KEY=
# The number civilians text when they have no data signal (shown as a "Text GEAMS" button only when set):
# GEAMS_SMS_NUMBER=
# Your SMS gateway forwards each received text to /api/sms/inbound with this key:
# GEAMS_SMS_INBOUND_KEY=

# ---- 112 hand-over: lets the national 112 service post each call so the nearest control room is told too ----
# GEAMS_E112_KEY=
